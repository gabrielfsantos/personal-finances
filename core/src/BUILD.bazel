load("@rules_cc//cc:defs.bzl", "cc_library")
# load("//tools/lint:linters.bzl", "clang_tidy", "clang_tidy_test")

cc_library(
    name = "currency",
    srcs = ["currency.cpp"],
    hdrs = ["currency.h"],
    visibility = ["//core/src/tests:__subpackages__"],
)

cc_library(
    name = "money_errors",
    hdrs = ["money_errors.h"],
)

cc_library(
    name = "money",
    srcs = ["money.cpp"],
    hdrs = ["money.h"],
    visibility = ["//core/src/tests:__subpackages__"],
    deps = [
        ":currency",
        ":money_errors",
    ],
)

cc_library(
    name = "transaction",
    srcs = ["transaction.cpp"],
    hdrs = ["transaction.h"],
    visibility = ["//core/src/tests:__subpackages__"],
    deps = [":money"],
)

cc_library(
    name = "hello_world",
    srcs = ["main.cpp"],
)

