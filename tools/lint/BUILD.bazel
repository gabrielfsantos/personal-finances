load("@bazel_skylib//rules:native_binary.bzl", "native_binary")

native_binary(
    name = "clang_tidy",
    src = "@llvm_toolchain//:clang-tidy",
    out = "clang_tidy",
)

sh_binary(
    name = "clang_tidy_runner",
    srcs = ["clang_tidy_runner.sh"],
    data = [":clang_tidy"],
    visibility = ["//visibility:public"],
)
